; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Room Designer 3D"
config/version="1.42.0"
run/main_scene="res://scenes/main.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.5", "Mobile")
config/icon="res://assets/icon.svg"
boot_splash/bg_color=Color(0.09, 0.1, 0.13, 1)
boot_splash/show_image=false

[autoload]

Catalog="*res://scripts/data/catalog.gd"
Jobs="*res://scripts/data/jobs.gd"
Perks="*res://scripts/data/perks.gd"
Staff="*res://scripts/data/staff.gd"
Game="*res://scripts/data/game_state.gd"
Industry="*res://scripts/data/industry.gd"
Icons="*res://scripts/world/item_icons.gd"
Audio="*res://scripts/audio/audio.gd"
SmokeTest="*res://tests/smoke_test.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.09, 0.1, 0.13, 1)
